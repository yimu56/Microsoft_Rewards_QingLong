# =============================================================================
# .env.local — 本地环境变量模板（可安全提交，不含任何真实凭据）
# 复制为 .env.local 并填入真实值；该文件已被 .gitignore 排除。
# 命令行 / 青龙面板里的同名环境变量优先于本文件。
# =============================================================================

# 【必填 1】微软 OAuth refresh_token，用 `node get_token.js` 获取
MSR_REFRESH_TOKEN=

# 【必填 2】rewards.bing.com 的完整 Cookie，F12 → Network → 主文档请求头 Cookie
MSR_COOKIE=

# 【可选】测试时关掉推送，避免把测试消息发到群里
MSR_QL_NOTIFY=0
